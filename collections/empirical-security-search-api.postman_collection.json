  "info": {
    "_postman_id": "65e6f14a-7145-43ea-8a9d-6ea6e4aca6fc",
    "name": "Empirical Security CVE Groups Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Empirical Security API provides programmatic access to real-time exploitation prediction scores for CVEs. It exposes the Foundation (global) model, hourly-updated EPSS models (epss_v3/epss_v4/epss_v5), and organization-specific Radiant models, along with CVE detail, malware-hash, critical-indicator, score-history, change-history, and saved CVE-group endpoints. Authentication is OAuth 2.0 client credentials (JWT bearer).\n\nContact Support:\n Name: Empirical Security",
      "type": "text/plain"
    }
  }
